#!/usr/bin/env ruby

require 'i18n'
require 'thor'
require 'mustache'
require_relative '../lib/json_resume'
require 'fileutils'
require 'rbconfig'
require 'tmpdir'
require 'timeout'
require 'zlib'

class String
        def red;            "\033[31m#{self}\033[0m" end
        def green;          "\033[32m#{self}\033[0m" end
end

class JsonResumeCLI < Thor

  def self.exit_on_failure?
    true
  end

  desc "convert /path/to/json/file", "converts the json to pretty resume format"
  option :out, :default=>"html", :banner=>"output_type", :desc=>"html|html_pdf|tex|tex_pdf|md"
  option :template, :banner=>"template_path", :desc=>"path to customized template (optional)"
	option :locale, :default=>"en", :banner=>"locale", :desc=>"en|es|pt"
	option :theme, :default=>"default", :banner=>"theme", :desc=>"default|classic"
  def convert(json_input)
		set_i18n(options[:locale])
    puts "Generating the #{options[:out]} type..."
    begin
      puts send('convert_to_'+options[:out], json_input, get_template(options))
    rescue Encoding::InvalidByteSequenceError
      puts "ERROR: You need to 'export LC_CTYPE=en_US.UTF-8' ...".green
    end
  end

  desc "sample", "Generates a sample json file in cwd"
  def sample()
    sample_path = File.join(Dir.pwd, 'resume.sample.json')
    sample = {
      'firstname' => 'Your',
      'familyname' => 'Name',
      'bio_data' => {
        'email' => 'you@example.com',
        'summary' => {
          'points' => ['Replace this text with a short professional summary.']
        }
      }
    }

    File.open(sample_path, 'w') { |file| file.write(JSON.pretty_generate(sample)) }
    puts "Generated #{sample_path}.".green
    puts 'You can now modify it and run: bundle exec ruby bin/json_resume convert resume.sample.json'
  end

  no_commands do
    @@orig_locn = File.expand_path(File.dirname(__FILE__))

    def get_template(options)
      return options[:template] if options[:template]
      out_type = options[:out].split('_').first #html for both html, html_pdf
      out_type = 'html' if out_type == 'pdf'
			theme = options[:theme]
			template_path = "#{@@orig_locn}/../templates/#{theme}_#{out_type}.mustache"
			if !File.exist?(template_path) && theme != 'default'
				puts "Theme #{theme} doesn't exist for #{options[:out]} type yet! Using default...".red
				template_path = "#{@@orig_locn}/../templates/default_#{out_type}.mustache"
			end
			return template_path
    end

    def convert_to_html(json_input, template, dest=Dir.pwd, dir_name='resume')
			dest_dir = "#{dest}/#{dir_name}"
			FileUtils.mkdir_p dest_dir
			FileUtils.cp_r(Dir["#{@@orig_locn}/../extras/resume_html/*"], dest_dir)
      page_path = "#{dest_dir}/page.html"
      resume_context = nil
      msg = generate_file(json_input, template, "html", page_path) do |context|
        resume_context = context
      end
      embed_page(page_path, "#{dest_dir}/index.html", resume_context)
      embed_page(page_path, "#{dest_dir}/core-page.html", resume_context)
      msg += "\nOpen #{dest_dir}/index.html or run `bundle exec rake serve`."
    end

    def convert_to_pdf(json_input, template, dest=Dir.pwd)
      puts "Defaulting to 'html_pdf'..."
      convert_to_html_pdf(json_input, template, dest)
    end

    def convert_to_html_pdf(json_input, template, dest=Dir.pwd)
      renderer = pdf_renderer_path
      unless renderer
        raise Thor::Error, <<~MESSAGE.strip
          HTML PDF output requires chrome-headless-shell.
          Install it with: npx @puppeteer/browsers install chrome-headless-shell@stable
          Then set JSON_RESUME_PDF_RENDERER to the executable path if it is not discovered automatically.
        MESSAGE
      end

      destination_dir = File.expand_path(dest)
      destination_pdf = File.join(destination_dir, 'resume.pdf')
      FileUtils.mkdir_p(destination_dir)

      Dir.mktmpdir('.json-resume-pdf-', destination_dir) do |workspace|
        convert_to_html(json_input, template, workspace, 'resume')
        html_path = File.join(workspace, 'resume', 'core-page.html')
        staged_pdf = File.join(workspace, 'resume.pdf')

        render_html_pdf(renderer, html_path, staged_pdf, workspace)
        validate_pdf(staged_pdf)
        File.rename(staged_pdf, destination_pdf)
      end

      "\nGenerated resume.pdf at #{destination_dir}.".green
    end

    def convert_to_tex(json_input, template, dest=Dir.pwd, filename="resume.tex")
      generate_file(json_input, template, "latex", "#{dest}/#{filename}")
    end

    def convert_to_tex_pdf(json_input, template, dest=Dir.pwd)
      file1 = "resume"; filename = "#{file1}.tex"
      convert_to_tex(json_input, template, dest, filename)
      unless executable_path('pdflatex')
        raise Thor::Error,
              "LaTeX PDF output requires pdflatex. The TeX source was generated at #{dest}/#{filename}."
      end
      needs_moderncv = options[:theme] != 'classic'
      if needs_moderncv && !(executable_path('kpsewhich') && system('kpsewhich', 'moderncv.cls', :out => File::NULL))
        raise Thor::Error,
              "LaTeX PDF output requires the moderncv package. The TeX source was generated at #{dest}/#{filename}."
      end
      success = system(
        'pdflatex',
        '-interaction=nonstopmode',
        filename,
        :chdir => dest
      )
      raise Thor::Error, 'pdflatex failed; resume.tex was kept for inspection.' unless success

      [".tex",".out",".aux",".log"].each do |ext|
				FileUtils.rm_f "#{dest}/#{file1}#{ext}"
      end
      msg = "\nPDF is ready at #{dest}/#{file1}.pdf"
    end

    def executable_path(command)
      ENV.fetch('PATH', '').split(File::PATH_SEPARATOR).each do |path|
        candidate = File.join(path, command)
        return candidate if File.file?(candidate) && File.executable?(candidate)
      end

      nil
    end

    def pdf_renderer_path
      override = ENV['JSON_RESUME_PDF_RENDERER']
      if override && !override.strip.empty?
        candidate = File.expand_path(override)
        unless File.file?(candidate) && File.executable?(candidate)
          raise Thor::Error,
                "JSON_RESUME_PDF_RENDERER is not an executable file: #{candidate}"
        end
        return candidate
      end

      path_renderer = executable_path('chrome-headless-shell') ||
                      executable_path('chrome-headless-shell.exe')
      return path_renderer if path_renderer

      pdf_renderer_cache_candidates
        .select { |candidate| File.file?(candidate) && File.executable?(candidate) }
        .max_by { |candidate| pdf_renderer_sort_key(candidate) }
    end

    def pdf_renderer_cache_candidates
      home = Dir.home
      roots = [
        ENV['PLAYWRIGHT_BROWSERS_PATH'],
        File.join(home, 'Library', 'Caches', 'ms-playwright'),
        File.join(home, '.cache', 'ms-playwright'),
        File.join(home, 'AppData', 'Local', 'ms-playwright'),
        ENV['PUPPETEER_CACHE_DIR'],
        File.join(home, 'Library', 'Caches', 'puppeteer', 'chrome-headless-shell'),
        File.join(home, '.cache', 'puppeteer', 'chrome-headless-shell'),
        File.join(home, 'AppData', 'Local', 'puppeteer', 'chrome-headless-shell')
      ].compact.reject(&:empty?).uniq

      roots.flat_map do |root|
        %w[chrome-headless-shell chrome-headless-shell.exe].flat_map do |executable|
          Dir.glob(File.join(File.expand_path(root), '**', executable))
        end
      end.uniq
    end

    def pdf_renderer_sort_key(path)
      components = path.split(File::SEPARATOR)
      revision = components.map do |component|
        component[/chromium_headless_shell-(\d+)/, 1] ||
          (component.match?(/\A\d+(?:\.\d+){2,}\z/) ? component : nil)
      end.compact.last
      version = revision.to_s.split('.').map(&:to_i)

      [version, File.mtime(path).to_f, path]
    end

    def render_html_pdf(renderer, html_path, output_path, workspace)
      log_path = File.join(workspace, 'renderer.log')
      profile_path = File.join(workspace, 'chromium-profile')
      command = [
        renderer,
        '--headless',
        '--disable-background-networking',
        '--disable-component-update',
        '--disable-default-apps',
        '--disable-extensions',
        '--disable-gpu',
        '--no-first-run',
        '--no-default-browser-check',
        '--no-pdf-header-footer',
        '--timeout=5000',
        "--user-data-dir=#{profile_path}",
        "--print-to-pdf=#{output_path}",
        File.expand_path(html_path)
      ]

      status = nil
      File.open(log_path, 'w') do |log|
        pid = Process.spawn(*command, :out => log, :err => log, :pgroup => true)
        status = wait_for_pdf_renderer(pid)
      end

      return if status.success?

      outcome = status.signaled? ? "signal #{status.termsig}" : "exit #{status.exitstatus}"
      details = File.read(log_path).lines.last(12).join.strip
      message = "PDF renderer failed (#{outcome})."
      message += "\n#{details}" unless details.empty?
      raise Thor::Error, message
    rescue Errno::ENOENT => error
      raise Thor::Error, "PDF renderer could not be started: #{error.message}"
    end

    def wait_for_pdf_renderer(pid)
      timeout_seconds = parse_pdf_timeout

      Timeout.timeout(timeout_seconds) do
        Process.wait2(pid).last
      end
    rescue Timeout::Error
      terminate_pdf_renderer(pid)
      raise Thor::Error,
            "PDF renderer timed out after #{timeout_seconds} seconds and was stopped."
    end

    def parse_pdf_timeout
      timeout_seconds = Float(ENV.fetch('JSON_RESUME_PDF_TIMEOUT', '30'))
      raise ArgumentError unless timeout_seconds.finite? && timeout_seconds > 0

      timeout_seconds
    rescue ArgumentError
      raise Thor::Error, 'JSON_RESUME_PDF_TIMEOUT must be a positive number.'
    end

    def terminate_pdf_renderer(pid)
      process_target = windows_platform? ? pid : -pid
      Process.kill('TERM', process_target)
      deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + 0.5

      loop do
        result = Process.waitpid2(pid, Process::WNOHANG)
        return result.last if result
        break if Process.clock_gettime(Process::CLOCK_MONOTONIC) >= deadline
        sleep 0.05
      end

      Process.kill('KILL', process_target)
      Process.wait2(pid).last
    rescue Errno::ECHILD, Errno::EINVAL, Errno::ESRCH, NotImplementedError
      nil
    end

    def windows_platform?
      RbConfig::CONFIG['host_os'].match?(/mswin|mingw|cygwin/i)
    end

    def validate_pdf(path)
      unless File.file?(path) && File.size(path) > 8
        raise Thor::Error, 'PDF renderer did not create a PDF file.'
      end

      File.open(path, 'rb') do |file|
        header = file.read(5)
        tail_size = [File.size(path), 2048].min
        file.seek(-tail_size, IO::SEEK_END)
        trailer = file.read(tail_size)

        unless header == '%PDF-' && trailer.include?('%%EOF')
          raise Thor::Error, 'PDF renderer produced an invalid PDF file.'
        end
      end
    end

    def convert_to_md(json_input, template, dest=Dir.pwd)
      generate_file(json_input, template, "markdown", "#{dest}/resume.md")
    end

		def set_i18n(locale)
			I18n.load_path = Dir["#{@@orig_locn}/../locale/*.yml"]
			I18n.enforce_available_locales = true
			I18n.locale = locale.to_sym
		end

		def i18n(text)
			text.gsub(/##(\w*?)##/) do
        I18n.t(Regexp.last_match[1], :scope => 'headings', :raise => true)
      end
		end

    def embed_page(page_path, layout_path, resume_context)
      marker = '{{{resume_content}}}'
      layout = File.read(layout_path)
      raise "Missing #{marker} in #{layout_path}" unless layout.include?(marker)

      layout_context = resume_context.merge('resume_content' => File.read(page_path))
      rendered_layout = Mustache.render(layout, layout_context).rstrip + "\n"
      File.open(layout_path, 'w') do |file|
        file.write(rendered_layout)
      end
    end

    def generate_file(json_input, template, output_type, dest)
      resume_obj = JsonResume.new(json_input, "output_type" => output_type)
      mustache_obj  = Mustache.render(i18n(File.read(template)), resume_obj.reader.hash)
      mustache_obj = mustache_obj.rstrip + "\n"
      File.open(dest,'w') {|f| f.write(mustache_obj) }
      yield resume_obj.reader.hash if block_given?
      return "\nGenerated files present at #{dest}".green
    end

  end

end

JsonResumeCLI.start(ARGV)
